              "alignment": "mid-left",
              "font": {
                "size": 16
              },
              "colors": {
                "text": {
                  "normal": "#FFFFFFFF"
                }
              }
            },
            {
              "type": "edit-box",
              "id": "nameEdit",
              "rect": {
                "x": 110,
                "y": 20,
                "w": 250,
                "h": 30
              },
              "placeholder": "Please input your name",
