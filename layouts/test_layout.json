            "#FF0000",
            "#00FF00",
            "#0000FF",
            "#FFFF00",
            "#FF00FF"
          ],
          "presetLayout": {
            "cols": 5,
            "rows": 1
          },
          "events": {
            "onColorChanged": "onColorChanged"
          }
        },
