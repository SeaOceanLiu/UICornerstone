{
  "version": "1.1",
  "controls": [
    {
      "type": "panel",
      "id": "mainPanel",
      "rect": {
        "x": 0,
        "y": 0,
        "w": 800,
        "h": 640
      },
      "colors": {
        "background": {
          "normal": "#282828FF"
        }
      },
      "children": [
        {
          "type": "menu-bar",
          "id": "mainMenuBar",
          "font": {
            "size": 16
          },
          "menus": [
            {
              "caption": "文件(F)",
              "items": [
                {
                  "caption": "新建",
                  "shortcut": "Ctrl+N",
                  "events": {
                    "onClick": "onMenuNew"
                  }
                },
                {
                  "caption": "打开",
                  "shortcut": "Ctrl+O",
                  "events": {
                    "onClick": "onMenuOpen"
                  }
                },
                {
                  "type": "separator"
                },
                {
                  "caption": "最近文件",
                  "items": [
                    {
                      "caption": "file1.txt",
                      "events": {
                        "onClick": "onMenuRecent"
                      }
                    },
                    {
                      "caption": "file2.txt",
                      "events": {
                        "onClick": "onMenuRecent"
                      }
                    }
                  ]
                },
                {
                  "type": "separator"
                },
                {
                  "caption": "退出",
                  "shortcut": "Alt+F4",
                  "events": {
                    "onClick": "onMenuExit"
                  }
                }
              ]
            },
            {
              "caption": "编辑(E)",
              "items": [
                {
                  "caption": "撤销",
                  "shortcut": "Ctrl+Z",
                  "events": {
                    "onClick": "onMenuUndo"
                  }
                },
                {
                  "caption": "重做",
                  "shortcut": "Ctrl+Y",
                  "events": {
                    "onClick": "onMenuRedo"
                  }
                }
              ]
            },
            {
              "caption": "帮助(H)",
              "items": [
                {
                  "caption": "关于",
                  "events": {
                    "onClick": "onMenuAbout"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "label",
          "id": "titleLabel",
          "rect": {
            "x": 0,
            "y": 52,
            "w": 800,
            "h": 40
          },
          "caption": "Layout Configuration Test",
          "alignment": "center",
          "font": {
            "name": "HarmonyOS_Sans_SC_Regular",
            "size": 28
          },
          "colors": {
            "text": {
              "normal": "#FFFFFFFF"
            }
          },
          "shadow": {
            "enabled": true,
            "offset": {
              "x": 2,
              "y": 2
            }
          }
        },
        {
          "type": "panel",
          "id": "formPanel",
          "rect": {
            "x": 50,
            "y": 112,
            "w": 400,
            "h": 200
          },
          "colors": {
            "border": {
              "normal": "#808080FF"
            }
          },
          "children": [
            {
              "type": "label",
              "id": "nameLabel",
