          "caption-size": 14,
          "check-state": "unchecked",
          "style": "classic",
          "layout": "text-right",
          "events": {
            "onCheckChanged": "onAgreeChanged"
          }
        },
        {
          "type": "check-box",
          "id": "optionCheck",
          "rect": {
            "x": 240,
            "y": 462,
            "w": 180,
            "h": 30
          },
          "caption": "Enable option",
          "caption-size": 14,
          "check-state": "checked",
          "style": "cross",
          "layout": "text-right"
        },
        {
          "type": "progress-bar",
