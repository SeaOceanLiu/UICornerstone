                "x": 280,
                "y": 140,
                "w": 100,
                "h": 35
              },
              "caption": "Submit",
              "caption-size": 16,
              "colors": {
                "background": {
                  "normal": "#4060A0FF",
                  "hover": "#5080C0FF",
                  "pressed": "#305090FF"
                },
                "border": {
                  "normal": "#6080C0FF"
                },
                "text": {
                  "normal": "#FFFFFFFF"
                }
              },
              "events": {
                "onClick": "onSubmitClick"
