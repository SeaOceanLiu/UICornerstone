{
  "version": "1.1",
  "viewport": {
    "width": 800,
    "height": 1000
  },
  "components": {
    "greeter": {
      "props": {
        "name": {
          "type": "string",
          "default": "World"
        },
        "buttonText": {
          "type": "string",
          "default": "Click"
        }
      },
      "template": {
        "type": "panel",
        "rect": {
          "x": 0,
          "y": 0,
          "w": 200,
          "h": 60
        },
        "children": [
          {
            "type": "label",
            "id": "greeting",
            "rect": {
              "x": 10,
              "y": 5,
              "w": 180,
              "h": 24
            },
            "caption": "Hello, {{name}}!",
            "font": {
              "size": 14
            },
            "alignment": "center"
          },
          {
            "type": "button",
            "id": "btn",
            "rect": {
              "x": 50,
              "y": 32,
              "w": 100,
              "h": 24
            },
            "caption": "{{buttonText}}",
            "events": {
              "onClick": "_comp_onGreet"
            }
          }
        ]
      }
    },
    "framed-greeter": {
      "props": {
        "name": {
          "type": "string",
          "default": "World"
        },
        "buttonText": {
          "type": "string",
          "default": "Click"
        }
      },
      "template": {
        "type": "panel",
        "rect": {
          "x": 0,
          "y": 0,
          "w": 220,
          "h": 80
        },
        "background": "#3A3A3AFF",
        "border": "#808080FF",
        "children": [
          {
            "type": "greeter",
            "id": "nestedgreeter",
            "rect": {
              "x": 10,
              "y": 10,
              "w": 200,
              "h": 60
            },
            "name": "{{name}}",
            "buttonText": "{{buttonText}}",
            "events": {
              "onGreet": "_comp_onGreet"
            }
          }
        ]
      }
    },
    "self-ref": {
      "template": {
        "type": "panel",
        "rect": {
          "x": 0,
          "y": 0,
          "w": 200,
          "h": 100
        },
        "background": "#3A3A3AFF",
        "children": [
          {
            "type": "self-ref",
            "id": "child",
            "rect": {
              "x": 10,
              "y": 10,
              "w": 180,
              "h": 80
            }
          }
        ]
      }
    }
  },
